# ─────────────────────────────────────────────────────────────
# DERMASENSE-BACKEND — variables de entorno
# Copiar a .env y completar. NUNCA subir .env al repositorio.
# ─────────────────────────────────────────────────────────────

# Supabase — MISMO proyecto que el frontend (ver conexion.md §5).
# SUPABASE_URL y SUPABASE_ANON_KEY son el mismo valor que
# NEXT_PUBLIC_SUPABASE_URL y NEXT_PUBLIC_SUPABASE_ANON_KEY del frontend.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# Verificacion de la firma del JWT. Se necesita UNA de las dos vias:
#
#   a) Proyectos con firma simetrica (legacy): pegar el JWT Secret del panel.
#      Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=
#
#   b) Proyectos con JWT Signing Keys asimetricas (ES256/RS256, por defecto en
#      proyectos nuevos): dejar el secreto vacio. El backend descubre la clave
#      publica en {SUPABASE_URL}/auth/v1/.well-known/jwks.json.
#      Solo definir esta variable si el JWKS vive en otra URL.
SUPABASE_JWKS_URL=

# SUPABASE_SERVICE_ROLE_KEY NO va aqui y no debe usarse en este servicio.
# Omite RLS y queda reservada a migraciones y seed, en el repositorio frontend.

# ─────────────────────────────────────────────────────────────
# Proveedor de IA: anthropic | openrouter
#
# El modelo es el mismo en los dos caminos (claude-sonnet-5, TRD §1) y la tarifa
# tambien ($2 / $10 por millon de tokens). Solo cambia por donde sale la
# peticion y que clave hace falta.
# ─────────────────────────────────────────────────────────────
AI_PROVIDER=anthropic

# a) Anthropic directo — console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# b) OpenRouter — openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Tope de tokens del reporte. Medido: un reporte en espanol ocupa ~1360 tokens,
# asi que 1200 (el valor de docs/AI_PROMPTS.md) lo corta a mitad de frase.
AI_MAX_TOKENS=2000
AI_TIMEOUT_SECONDS=60

# Sintesis de voz: browser | elevenlabs | azure
TTS_PROVIDER=browser
TTS_API_KEY=
TTS_AZURE_REGION=

# Dominios del frontend autorizados, separados por coma
CORS_ORIGINS=http://localhost:3000

# Entorno: development | production
ENVIRONMENT=development
